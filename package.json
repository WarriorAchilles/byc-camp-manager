{
  "name": "byc-camp-manager",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "infra/cdk"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server && npm run test -w client && npm run test -w infra/cdk",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed:prod": "npm run db:seed:prod -w server",
    "db:generate": "npm run db:generate -w server",
    "season:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seasonal-operation.ps1 -Operation STATUS",
    "season:wake": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seasonal-operation.ps1 -Operation WAKE",
    "season:hibernate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seasonal-operation.ps1 -Operation HIBERNATE",
    "season:recover:wake": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seasonal-operation.ps1 -Operation WAKE -Recover",
    "season:recover:hibernate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seasonal-operation.ps1 -Operation HIBERNATE -Recover"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2"
  }
}
