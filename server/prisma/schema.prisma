generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  super_admin
  camp_admin
}

enum Gender {
  male
  female
}

enum ImportSource {
  online_registration
  csv_import
  admin_entry
}

enum CamperPaymentStatus {
  unpaid
  paid_stripe
  paid_cash
  paid_church_check
  paid_church_cash
}

enum CheckInStatus {
  not_checked_in
  checked_in
}

enum StripeCheckoutStatus {
  pending
  completed
  failed
  expired
}

enum StripeCheckoutPurpose {
  self_check_in
  family_registration
}

enum RegistrationState {
  pending_payment
  confirmed
  expired
  cancelled
}

enum RegistrationPaymentMethod {
  stripe
  cash
}

enum LegalSignatureMethod {
  typed
  drawn
}

enum ReceiptLineType {
  registration
  merchandise
  discount
}

enum MerchandiseOwnership {
  family
  camper
}

enum EmailDeliveryStatus {
  pending
  sent
  skipped
  failed
}

enum WorkerRegistrationSubmissionStatus {
  created
  pending_review
  linked_existing
  dismissed
}

enum DormPurpose {
  camper
  worker
}

enum DormGenderDesignation {
  boys
  girls
  co_ed
}

enum ChurchPaymentTender {
  check
  cash
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole
  createdById  String?   @map("created_by_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdBy     AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins AdminUser[] @relation("AdminCreatedBy")
  churchPaymentsEntered ChurchPayment[] @relation("ChurchPaymentEnteredBy")
  churchPaymentsVoided  ChurchPayment[] @relation("ChurchPaymentVoidedBy")
  churchAuditLogs       ChurchAuditLog[]

  @@map("admin_users")
}

/**
 * Singleton row (`id` = `default`) for organization-wide UI defaults.
 */
model AppSettings {
  id               String   @id @default("default")
  /**
   * Organization-wide active camp year used by admin operations and public registration.
   */
  activeCampYearId String?  @unique @map("active_camp_year_id")
  updatedAt        DateTime @updatedAt @map("updated_at")

  activeCampYear CampYear? @relation(fields: [activeCampYearId], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model CampYear {
  id                                String    @id @default(uuid())
  name                              String
  yearLabel                         String    @map("year_label")
  startDate                         DateTime  @map("start_date") @db.Date
  endDate                           DateTime  @map("end_date") @db.Date
  camperCapacity                    Int?      @map("camper_capacity")
  familyRegistrationOpensAt         DateTime? @map("family_registration_opens_at")
  familyRegistrationClosesAt        DateTime? @map("family_registration_closes_at")
  familyRegistrationEnabled         Boolean   @default(false) @map("family_registration_enabled")
  familyRegistrationHeaderContent   String    @default("Camper registration details will be posted here. Please contact the camp office with questions.") @map("family_registration_header_content") @db.Text
  familyRegistrationClosedMessage   String    @default("Camper registration is currently closed.") @map("family_registration_closed_message") @db.Text
  workerRegistrationOpensAt         DateTime? @map("worker_registration_opens_at")
  workerRegistrationClosesAt        DateTime? @map("worker_registration_closes_at")
  workerRegistrationEnabled         Boolean   @default(false) @map("worker_registration_enabled")
  workerRegistrationHeaderContent   String    @default("Worker registration details will be posted here. Please contact the camp office with questions.") @map("worker_registration_header_content") @db.Text
  workerRegistrationClosedMessage   String    @default("Worker registration is currently closed.") @map("worker_registration_closed_message") @db.Text
  leaderRegistrationOpensAt         DateTime? @map("leader_registration_opens_at")
  leaderRegistrationClosesAt        DateTime? @map("leader_registration_closes_at")
  leaderRegistrationEnabled         Boolean   @default(false) @map("leader_registration_enabled")
  leaderRegistrationHeaderContent   String    @default("Leader registration details will be posted here. Please contact the camp office with questions.") @map("leader_registration_header_content") @db.Text
  leaderRegistrationClosedMessage   String    @default("Leader registration is currently closed.") @map("leader_registration_closed_message") @db.Text
  feeCutoverAt                      DateTime? @map("fee_cutover_at")
  earlyCamperFeeCents               Int?      @map("early_camper_fee_cents")
  lateCamperFeeCents                Int?      @map("late_camper_fee_cents")
  thirdPlusCamperFeeCents           Int?      @map("third_plus_camper_fee_cents")
  /**
   * Opaque hex token for camper self-service check-in kiosk URL / QR (nullable until issued).
   */
  selfCheckInToken                  String?   @unique @map("self_check_in_token")
  /**
   * When false, staff Check-in hides the option to check in and cash-pay all campers sharing a guardian email.
   */
  checkInFamilyPaymentOptionEnabled Boolean   @default(false) @map("check_in_family_payment_option_enabled")
  /**
   * When false, app-managed guardian confirmation emails are not sent after camper check-in.
   */
  checkInConfirmationEmailsEnabled  Boolean   @default(false) @map("check_in_confirmation_emails_enabled")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  ageGroupBrackets              AgeGroupBracket[]
  dorms                         Dorm[]
  campers                       Camper[]
  familyRegistrations           FamilyRegistration[]
  merchandiseItems              MerchandiseItem[]
  workers                       Worker[]
  workerRegistrationSubmissions WorkerRegistrationSubmission[]
  dormLeaders                   DormLeader[]
  churchPayments                ChurchPayment[]
  appSettingsAsActiveCampYear   AppSettings?

  @@map("camp_years")
}

model Church {
  id                   String    @id @default(uuid())
  name                 String
  normalizedName       String    @map("normalized_name")
  pastorName           String    @map("pastor_name")
  normalizedPastorName String    @map("normalized_pastor_name")
  mergedIntoChurchId   String?   @map("merged_into_church_id")
  reviewedAt           DateTime? @map("reviewed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  mergedIntoChurch Church?  @relation("ChurchMerges", fields: [mergedIntoChurchId], references: [id], onDelete: Restrict)
  mergedChurches   Church[] @relation("ChurchMerges")
  aliases          ChurchAlias[]
  campers          Camper[]
  workers          Worker[]
  workerRegistrationSubmissions WorkerRegistrationSubmission[]
  dormLeaders      DormLeader[]
  payments         ChurchPayment[]
  auditLogsAsSource ChurchAuditLog[] @relation("ChurchAuditSource")
  auditLogsAsTarget ChurchAuditLog[] @relation("ChurchAuditTarget")

  @@unique([normalizedName, normalizedPastorName])
  @@index([name])
  @@index([pastorName])
  @@index([mergedIntoChurchId])
  @@map("churches")
}

model ChurchAlias {
  id                   String   @id @default(uuid())
  churchId             String   @map("church_id")
  name                 String
  normalizedName       String   @map("normalized_name")
  pastorName           String   @map("pastor_name")
  normalizedPastorName String   @map("normalized_pastor_name")
  createdAt            DateTime @default(now()) @map("created_at")

  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)

  @@unique([normalizedName, normalizedPastorName])
  @@index([churchId])
  @@index([name])
  @@map("church_aliases")
}

model ChurchAuditLog {
  id                String   @id @default(uuid())
  actorAdminUserId  String   @map("actor_admin_user_id")
  action            String
  sourceChurchId    String?  @map("source_church_id")
  targetChurchId    String?  @map("target_church_id")
  affectedRecordIds Json     @map("affected_record_ids")
  details           Json?
  createdAt         DateTime @default(now()) @map("created_at")

  actor        AdminUser @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)
  sourceChurch Church?   @relation("ChurchAuditSource", fields: [sourceChurchId], references: [id], onDelete: SetNull)
  targetChurch Church?   @relation("ChurchAuditTarget", fields: [targetChurchId], references: [id], onDelete: SetNull)

  @@index([actorAdminUserId, createdAt])
  @@index([sourceChurchId])
  @@index([targetChurchId])
  @@map("church_audit_logs")
}

model AgeGroupBracket {
  id         String  @id @default(uuid())
  campYearId String  @map("camp_year_id")
  label      String
  minAge     Int     @map("min_age")
  maxAge     Int     @map("max_age")
  sortOrder  Int     @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")

  campYear CampYear @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  dorms    Dorm[]

  @@index([campYearId])
  @@map("age_group_brackets")
}

model Dorm {
  id                String                @id @default(uuid())
  campYearId        String                @map("camp_year_id")
  name              String
  purpose           DormPurpose
  genderDesignation DormGenderDesignation @map("gender_designation")
  bedCapacity       Int                   @map("bed_capacity")
  ageGroupBracketId String?               @map("age_group_bracket_id")

  campYear              CampYear         @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  ageGroupBracket       AgeGroupBracket? @relation(fields: [ageGroupBracketId], references: [id], onDelete: SetNull)
  campers               Camper[]
  workers               Worker[]
  dormLeaderAssignments DormLeader[]

  @@index([campYearId])
  @@map("dorms")
}

model Camper {
  id                    String              @id @default(uuid())
  campYearId            String              @map("camp_year_id")
  familyRegistrationId  String?             @map("family_registration_id")
  firstName             String              @map("first_name")
  lastName              String              @map("last_name")
  middleName            String?             @map("middle_name")
  dateOfBirth           DateTime            @map("date_of_birth") @db.Date
  gender                Gender
  streetAddress         String?             @map("street_address")
  city                  String?
  stateOrProvince       String?             @map("state_or_province")
  postalCode            String?             @map("postal_code")
  country               String?
  camperCellPhone       String?             @map("camper_cell_phone")
  guardianName          String              @map("guardian_name")
  guardianEmail         String              @map("guardian_email")
  guardianPhone         String              @map("guardian_phone")
  emergencyContactName  String?             @map("emergency_contact_name")
  emergencyContactPhone String?             @map("emergency_contact_phone")
  medicalNotes          String?             @map("medical_notes") @db.Text
  dietaryRestrictions   String?             @map("dietary_restrictions") @db.Text
  identifiesAsChristian Boolean?            @map("identifies_as_christian")
  receivedHolyGhost     Boolean?            @map("received_holy_ghost")
  churchName            String?             @map("church_name")
  pastorName            String?             @map("pastor_name")
  churchId              String?             @map("church_id")
  tShirtIntent          String?             @map("t_shirt_intent")
  allergies             String?             @db.Text
  medications           String?             @db.Text
  specialNeeds          String?             @map("special_needs") @db.Text
  /**
   * Camper fee import / accounting: amount due in cents (nullable until set).
   */
  feeDueCents           Int?                @map("fee_due_cents")
  /**
   * Camper fee import / accounting: amount paid in cents (nullable until set).
   */
  feePaidCents          Int?                @map("fee_paid_cents")
  paymentStatus         CamperPaymentStatus @map("payment_status")
  dormId                String?             @map("dorm_id")
  checkInStatus         CheckInStatus       @default(not_checked_in) @map("check_in_status")
  checkedInAt           DateTime?           @map("checked_in_at")
  medicalReleaseSigned  Boolean             @default(false) @map("medical_release_signed")
  importSource          ImportSource        @map("import_source")
  archivedAt            DateTime?           @map("archived_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  campYear               CampYear                @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  familyRegistration     FamilyRegistration?     @relation(fields: [familyRegistrationId], references: [id], onDelete: Cascade)
  dorm                   Dorm?                   @relation(fields: [dormId], references: [id], onDelete: SetNull)
  stripeCheckoutSessions StripeCheckoutSession[]
  merchandiseOrderLines  MerchandiseOrderLine[]
  church                  Church?                  @relation(fields: [churchId], references: [id], onDelete: SetNull)
  churchPaymentAllocations ChurchPaymentAllocation[]

  @@index([campYearId])
  @@index([churchId, campYearId])
  @@map("campers")
}

model FamilyRegistration {
  id                        String                     @id @default(uuid())
  submissionKey             String?                    @unique @map("submission_key")
  submissionDigest          String?                    @map("submission_digest")
  pendingSubmissionSnapshot Json?                      @map("pending_submission_snapshot")
  pendingCamperCount        Int                        @default(0) @map("pending_camper_count")
  campYearId                String                     @map("camp_year_id")
  state                     RegistrationState          @default(confirmed)
  guardianName              String                     @map("guardian_name")
  guardianEmail             String                     @map("guardian_email")
  guardianPhone             String                     @map("guardian_phone")
  guardianRelationship      String?                    @map("guardian_relationship")
  streetAddress             String?                    @map("street_address")
  city                      String?
  stateOrProvince           String?                    @map("state_or_province")
  postalCode                String?                    @map("postal_code")
  country                   String?
  paymentMethod             RegistrationPaymentMethod? @map("payment_method")
  paymentStatus             CamperPaymentStatus        @default(unpaid) @map("payment_status")
  registrationSubtotalCents Int                        @default(0) @map("registration_subtotal_cents")
  merchandiseSubtotalCents  Int                        @default(0) @map("merchandise_subtotal_cents")
  discountCents             Int                        @default(0) @map("discount_cents")
  totalDueCents             Int                        @default(0) @map("total_due_cents")
  amountPaidCents           Int                        @default(0) @map("amount_paid_cents")
  pricingSnapshot           Json?                      @map("pricing_snapshot")
  agreementVersion          String?                    @map("agreement_version")
  agreementTextSnapshot     String?                    @map("agreement_text_snapshot") @db.Text
  signatureMethod           LegalSignatureMethod?      @map("signature_method")
  signatureData             String?                    @map("signature_data") @db.Text
  legalAcknowledged         Boolean                    @default(false) @map("legal_acknowledged")
  signedAt                  DateTime?                  @map("signed_at")
  requestIp                 String?                    @map("request_ip")
  submittedAt               DateTime                   @default(now()) @map("submitted_at")
  confirmedAt               DateTime?                  @map("confirmed_at")
  expiresAt                 DateTime?                  @map("expires_at")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")

  campYear               CampYear                      @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  campers                Camper[]
  receiptLineItems       RegistrationReceiptLineItem[]
  merchandiseOrderLines  MerchandiseOrderLine[]
  stripeCheckoutSessions StripeCheckoutSession[]
  emailDeliveryAttempts  EmailDeliveryAttempt[]

  @@index([campYearId, state])
  @@index([campYearId, guardianEmail])
  @@index([paymentStatus])
  @@map("family_registrations")
}

model RegistrationReceiptLineItem {
  id                     String          @id @default(uuid())
  familyRegistrationId   String          @map("family_registration_id")
  lineType               ReceiptLineType @map("line_type")
  description            String
  quantity               Int             @default(1)
  unitPriceCents         Int             @map("unit_price_cents")
  originalUnitPriceCents Int?            @map("original_unit_price_cents")
  discountCents          Int             @default(0) @map("discount_cents")
  lineTotalCents         Int             @map("line_total_cents")
  pricingSnapshot        Json?           @map("pricing_snapshot")
  sortOrder              Int             @default(0) @map("sort_order")
  createdAt              DateTime        @default(now()) @map("created_at")

  familyRegistration FamilyRegistration @relation(fields: [familyRegistrationId], references: [id], onDelete: Cascade)

  @@index([familyRegistrationId, sortOrder])
  @@map("registration_receipt_line_items")
}

model MerchandiseItem {
  id               String               @id @default(uuid())
  campYearId       String               @map("camp_year_id")
  name             String
  description      String?              @db.Text
  priceCents       Int                  @map("price_cents")
  availableOptions Json                 @map("available_options")
  ownership        MerchandiseOwnership
  isActive         Boolean              @default(true) @map("is_active")
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  campYear   CampYear               @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  orderLines MerchandiseOrderLine[]

  @@index([campYearId, isActive, sortOrder])
  @@map("merchandise_items")
}

model MerchandiseOrderLine {
  id                      String               @id @default(uuid())
  familyRegistrationId    String               @map("family_registration_id")
  merchandiseItemId       String?              @map("merchandise_item_id")
  camperId                String?              @map("camper_id")
  pendingCamperIndex      Int?                 @map("pending_camper_index")
  ownership               MerchandiseOwnership
  itemNameSnapshot        String               @map("item_name_snapshot")
  selectedOptionsSnapshot Json?                @map("selected_options_snapshot")
  quantity                Int
  unitPriceCents          Int                  @map("unit_price_cents")
  lineTotalCents          Int                  @map("line_total_cents")
  createdAt               DateTime             @default(now()) @map("created_at")

  familyRegistration FamilyRegistration @relation(fields: [familyRegistrationId], references: [id], onDelete: Cascade)
  merchandiseItem    MerchandiseItem?   @relation(fields: [merchandiseItemId], references: [id], onDelete: SetNull)
  camper             Camper?            @relation(fields: [camperId], references: [id], onDelete: Cascade)

  @@index([familyRegistrationId])
  @@index([merchandiseItemId])
  @@index([camperId])
  @@map("merchandise_order_lines")
}

model EmailDeliveryAttempt {
  id                             String              @id @default(uuid())
  familyRegistrationId           String?             @map("family_registration_id")
  workerRegistrationSubmissionId String?             @map("worker_registration_submission_id")
  idempotencyKey                 String?             @unique @map("idempotency_key")
  templateKey                    String              @map("template_key")
  recipientEmail                 String              @map("recipient_email")
  status                         EmailDeliveryStatus @default(pending)
  attemptNumber                  Int                 @default(1) @map("attempt_number")
  providerMessageId              String?             @map("provider_message_id")
  errorCode                      String?             @map("error_code")
  errorMessage                   String?             @map("error_message")
  attemptedAt                    DateTime            @default(now()) @map("attempted_at")
  sentAt                         DateTime?           @map("sent_at")
  createdAt                      DateTime            @default(now()) @map("created_at")

  familyRegistration           FamilyRegistration?           @relation(fields: [familyRegistrationId], references: [id], onDelete: Cascade)
  workerRegistrationSubmission WorkerRegistrationSubmission? @relation(fields: [workerRegistrationSubmissionId], references: [id], onDelete: Cascade)

  @@index([familyRegistrationId, status])
  @@index([workerRegistrationSubmissionId, status])
  @@index([recipientEmail, attemptedAt])
  @@map("email_delivery_attempts")
}

model StripeCheckoutSession {
  id                   String                @id @default(uuid())
  stripeSessionId      String                @map("stripe_session_id")
  campYearId           String                @map("camp_year_id")
  camperId             String?               @map("camper_id")
  familyRegistrationId String?               @map("family_registration_id")
  purpose              StripeCheckoutPurpose @default(self_check_in)
  amountCents          Int                   @map("amount_cents")
  currency             String                @default("usd")
  status               StripeCheckoutStatus  @default(pending)
  paymentIntentId      String?               @map("payment_intent_id")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  camper             Camper?             @relation(fields: [camperId], references: [id], onDelete: Cascade)
  familyRegistration FamilyRegistration? @relation(fields: [familyRegistrationId], references: [id], onDelete: Cascade)

  @@index([stripeSessionId])
  @@index([campYearId])
  @@index([camperId])
  @@index([familyRegistrationId])
  @@index([paymentIntentId])
  @@map("stripe_checkout_sessions")
}

model ChurchPayment {
  id                    String              @id @default(uuid())
  churchId              String              @map("church_id")
  campYearId            String              @map("camp_year_id")
  tender                ChurchPaymentTender
  amountReceivedCents   Int                 @map("amount_received_cents")
  receivedDate          DateTime            @map("received_date") @db.Date
  referenceNumber       String?             @map("reference_number")
  notes                 String?             @db.Text
  enteredByAdminUserId  String              @map("entered_by_admin_user_id")
  idempotencyKey        String              @unique @map("idempotency_key")
  createdAt             DateTime            @default(now()) @map("created_at")
  voidedAt              DateTime?           @map("voided_at")
  voidedByAdminUserId   String?             @map("voided_by_admin_user_id")
  voidReason            String?             @map("void_reason") @db.Text

  church         Church                    @relation(fields: [churchId], references: [id], onDelete: Restrict)
  campYear       CampYear                  @relation(fields: [campYearId], references: [id], onDelete: Restrict)
  enteredBy      AdminUser                 @relation("ChurchPaymentEnteredBy", fields: [enteredByAdminUserId], references: [id], onDelete: Restrict)
  voidedBy       AdminUser?                @relation("ChurchPaymentVoidedBy", fields: [voidedByAdminUserId], references: [id], onDelete: Restrict)
  allocations    ChurchPaymentAllocation[]

  @@index([churchId, campYearId, receivedDate])
  @@index([campYearId, tender, voidedAt])
  @@map("church_payments")
}

model ChurchPaymentAllocation {
  id                 String   @id @default(uuid())
  churchPaymentId    String   @map("church_payment_id")
  camperId           String   @map("camper_id")
  appliedAmountCents Int      @map("applied_amount_cents")
  createdAt          DateTime @default(now()) @map("created_at")

  churchPayment ChurchPayment @relation(fields: [churchPaymentId], references: [id], onDelete: Restrict)
  camper        Camper        @relation(fields: [camperId], references: [id], onDelete: Restrict)

  @@unique([churchPaymentId, camperId])
  @@index([camperId, createdAt])
  @@map("church_payment_allocations")
}

model Worker {
  id                   String        @id @default(uuid())
  campYearId           String        @map("camp_year_id")
  email                String        @map("email")
  firstName            String        @map("first_name")
  lastName             String        @map("last_name")
  dateOfBirth          DateTime?     @map("date_of_birth") @db.Date
  gender               Gender
  cellPhone            String        @map("cell_phone")
  altPhone             String?       @map("alt_phone")
  streetAddress        String        @map("street_address")
  city                 String
  stateOrProvince      String        @map("state_or_province")
  postalCode           String        @map("postal_code")
  country              String
  taskPreferenceFirst  String?       @map("task_preference_first")
  taskPreferenceSecond String?       @map("task_preference_second")
  taskPreferenceThird  String?       @map("task_preference_third")
  tShirtSize           String?       @map("t_shirt_size")
  faithServingResponse String?       @map("faith_serving_response") @db.Text
  churchName           String?       @map("church_name")
  pastorName           String?       @map("pastor_name")
  churchId             String?       @map("church_id")
  pastorPhone          String?       @map("pastor_phone")
  publicSubmittedAt    DateTime?     @map("public_submitted_at")
  publicSubmissionIp   String?       @map("public_submission_ip")
  dormId               String?       @map("dorm_id")
  checkInStatus        CheckInStatus @default(not_checked_in) @map("check_in_status")
  checkedInAt          DateTime?     @map("checked_in_at")
  importSource         ImportSource  @map("import_source")
  archivedAt           DateTime?     @map("archived_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  campYear                        CampYear                       @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  dorm                            Dorm?                          @relation(fields: [dormId], references: [id], onDelete: SetNull)
  resolvedRegistrationSubmissions WorkerRegistrationSubmission[] @relation("WorkerRegistrationResolution")
  registrationMatches             WorkerRegistrationMatch[]
  church                          Church?                         @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([campYearId])
  @@index([campYearId, email])
  @@index([churchId, campYearId])
  @@map("workers")
}

model WorkerRegistrationSubmission {
  id                    String                             @id @default(uuid())
  submissionKey         String                             @unique @map("submission_key")
  submissionDigest      String                             @map("submission_digest")
  campYearId            String                             @map("camp_year_id")
  status                WorkerRegistrationSubmissionStatus
  email                 String
  firstName             String                             @map("first_name")
  lastName              String                             @map("last_name")
  dateOfBirth           DateTime?                          @map("date_of_birth") @db.Date
  gender                Gender
  cellPhone             String                             @map("cell_phone")
  altPhone              String?                            @map("alt_phone")
  streetAddress         String                             @map("street_address")
  city                  String
  stateOrProvince       String                             @map("state_or_province")
  postalCode            String                             @map("postal_code")
  country               String
  faithServingResponse  String                             @map("faith_serving_response") @db.Text
  churchName            String                             @map("church_name")
  pastorName            String                             @map("pastor_name")
  churchId              String?                            @map("church_id")
  pastorPhone           String                             @map("pastor_phone")
  taskPreferenceFirst   String                             @map("task_preference_first")
  taskPreferenceSecond  String                             @map("task_preference_second")
  taskPreferenceThird   String                             @map("task_preference_third")
  tShirtSize            String?                            @map("t_shirt_size")
  requestIp             String?                            @map("request_ip")
  submittedAt           DateTime                           @default(now()) @map("submitted_at")
  resolvedAt            DateTime?                          @map("resolved_at")
  resolvedByAdminUserId String?                            @map("resolved_by_admin_user_id")
  resolvedWorkerId      String?                            @map("resolved_worker_id")
  createdAt             DateTime                           @default(now()) @map("created_at")
  updatedAt             DateTime                           @updatedAt @map("updated_at")

  campYear              CampYear                  @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  resolvedWorker        Worker?                   @relation("WorkerRegistrationResolution", fields: [resolvedWorkerId], references: [id], onDelete: SetNull)
  likelyMatches         WorkerRegistrationMatch[]
  emailDeliveryAttempts EmailDeliveryAttempt[]
  church                Church?                    @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([campYearId, status, submittedAt])
  @@index([campYearId, email])
  @@index([churchId, campYearId])
  @@map("worker_registration_submissions")
}

model WorkerRegistrationMatch {
  id           String @id @default(uuid())
  submissionId String @map("submission_id")
  workerId     String @map("worker_id")
  matchReason  String @map("match_reason")

  worker                 Worker                       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  registrationSubmission WorkerRegistrationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, workerId])
  @@index([workerId])
  @@map("worker_registration_matches")
}

model DormLeader {
  id                     String        @id @default(uuid())
  campYearId             String        @map("camp_year_id")
  firstName              String        @map("first_name")
  lastName               String        @map("last_name")
  dateOfBirth            DateTime?     @map("date_of_birth") @db.Date
  gender                 Gender
  email                  String        @map("email")
  phone                  String
  altPhone               String?       @map("alt_phone")
  streetAddress          String?       @map("street_address")
  city                   String?
  stateOrProvince        String?       @map("state_or_province")
  postalCode             String?       @map("postal_code")
  country                String?
  maritalStatus          String?       @map("marital_status")
  faithServingResponse   String?       @map("faith_serving_response") @db.Text
  churchName             String?       @map("church_name")
  pastorName             String?       @map("pastor_name")
  churchId               String?       @map("church_id")
  pastorPhone            String?       @map("pastor_phone")
  roleLabel              String?       @map("role_label")
  tShirtSize             String?       @map("t_shirt_size")
  publicSubmittedAt      DateTime?     @map("public_submitted_at")
  publicSubmissionIp     String?       @map("public_submission_ip")
  publicSubmissionKey    String?       @unique @map("public_submission_key")
  publicSubmissionDigest String?       @map("public_submission_digest")
  assignedCamperDormId   String?       @map("assigned_camper_dorm_id")
  checkInStatus          CheckInStatus @default(not_checked_in) @map("check_in_status")
  checkedInAt            DateTime?     @map("checked_in_at")
  importSource           ImportSource  @map("import_source")
  archivedAt             DateTime?     @map("archived_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  campYear           CampYear @relation(fields: [campYearId], references: [id], onDelete: Cascade)
  assignedCamperDorm Dorm?    @relation(fields: [assignedCamperDormId], references: [id], onDelete: SetNull)
  church            Church?  @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([campYearId])
  @@index([campYearId, email])
  @@index([churchId, campYearId])
  @@map("dorm_leaders")
}
