# Copy to server/.env — the API loads this file automatically on startup (see config/env.ts).
# PostgreSQL connection (use a dedicated database per environment)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:15432/DATABASE?schema=public"

# At least 32 random bytes as hex/base64 in production
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# API port
PORT=4000

# Browser origin for the admin SPA (required in production for credentialed cookies)
# CORS_ORIGIN="http://localhost:5173"

# --- Stripe Checkout for camper self check-in ---
# APP_PUBLIC_URL is the public browser origin used in Stripe success/cancel redirects.
# Local Vite dev: http://localhost:5173
# Production: the public HTTPS origin for the deployed app, e.g. https://admin.example.org
APP_PUBLIC_URL="http://localhost:5173"

# Prefer a Stripe restricted API key (rk_test_... / rk_live_...) over a full secret key.
# Find/create it in Stripe Dashboard:
# Developers > API keys > Restricted keys > Create restricted key.
# Use test mode for development, then create a separate live-mode key before production.
# Grant the minimum permissions needed for Checkout Sessions and payment result lookup.
STRIPE_SECRET_KEY=""

# Webhook signing secret used to verify Stripe events.
# Local development: run
#   stripe listen --events checkout.session.completed --forward-to localhost:4000/api/stripe/webhook
# then copy the printed whsec_... value.
# Production: Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=""

# First super admin (run `npm run db:seed` from repo root after migrate)
# Default email when INITIAL_SUPER_ADMIN_EMAIL is unset: ZionEm7@gmail.com
INITIAL_SUPER_ADMIN_EMAIL="ZionEm7@gmail.com"
INITIAL_SUPER_ADMIN_PASSWORD=""

# --- Check-in confirmation email (SendGrid SMTP or compatible relay) ---
# See docs/development-plan/phase-1-camp-management/05-check-in-and-arrival-dashboard.md
# Use smtp for real delivery (e.g. SendGrid); use log (or similar) in CI/tests without network.
EMAIL_TRANSPORT="smtp"

# SendGrid SMTP relay: host smtp.sendgrid.net, port 587 (or 465), user literal "apikey", pass = API key with Mail Send.
# Other providers reuse these with their own host/port/credentials.
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS=""

# Must match SendGrid single-sender or domain authentication.
EMAIL_FROM="noreply@example.com"
